{
  "manifest_version": 3,
  "name": "シリーズの巻IDコピー",
  "version": "1.1.0",
  "description": "Kindleシリーズページの巻ASIN／BOOK OFFセットページの巻ISBNを、通し番号つきでクリップボードにコピーする",
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.co.jp/dp/*",
        "https://www.amazon.co.jp/*/dp/*",
        "https://www.amazon.co.jp/gp/product/*",
        "https://www.amazon.co.jp/kindle-dbs/product/*"
      ],
      "js": ["ui.js", "kindle.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://shopping.bookoff.co.jp/s/*"],
      "js": ["ui.js", "bookoff.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
